# Create a REAL .env file (this filename, no .example) in this same directory
# on PythonAnywhere, with actual values. gemini_app.py reads it itself at
# import time via its own _load_dotenv() - no PythonAnywhere-specific
# environment variable configuration is needed, this is the same mechanism
# used locally.
#
# Names only below. Never put a real key in this file or commit it anywhere.

# ---- Required ----------------------------------------------------------------
# Free tier, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional -------------------------------------------------------------
# Comma-separated model fallback chain. Default if unset:
# gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TAIGI_MODELS=

# Cross-checks each new translation with Claude before caching it. Unset is
# fine - gemini_taigi.py catches the failure and uses the unverified
# translation as-is. Setting this roughly doubles latency and cost on a
# cache miss.
# ANTHROPIC_API_KEY=

# "Azure Minnan" voice button. Unset means that button returns a clear error;
# 意傳科技 (the default voice) is unaffected.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ATEN AI Voice. gemini_index.html DOES have a live "ATEN 優聲學" toggle
# button, so leaving this unset means a visitor who clicks it gets a clear
# error ("ATEN_API_KEY is not set...") rather than silently doing nothing.
# At handoff time ATEN's monthly quota was exhausted - confirm it has reset
# before relying on this, or visitors will hit the same quota error.
# ATEN_API_KEY=
# ATEN_SERVER_URL=
# ATEN_ORATOR_NAME=
